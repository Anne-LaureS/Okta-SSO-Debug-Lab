meta {
  name: client-credentials-pkjwt
  type: http
  seq: 3
}

post {
  url: {{okta_org_url}}/oauth2/v1/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  scope: okta.users.read
  client_id: {{client_id}}
  client_assertion_type: urn:ietf:params:oauth:client-assertion-type:jwt-bearer
  client_assertion: {{client_assertion}}
}

script:pre-request {
  const crypto = require('crypto');
  const b64url = (buf) => buf.toString('base64').replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');

  const clientId = bru.getVar('client_id');
  const privateKeyPem = bru.getVar('oidc_private_key_pem');
  const kid = bru.getVar('oidc_kid');

  const tokenEndpoint = bru.getVar('okta_org_url') + '/oauth2/v1/token';

  const now = Math.floor(Date.now() / 1000);
  const header = { alg: 'RS256', typ: 'JWT', kid };
  const payload = {
    iss: clientId,
    sub: clientId,
    aud: tokenEndpoint,
    jti: crypto.randomBytes(16).toString('hex'),
    exp: now + 300,
    iat: now,
  };

  const headerB64 = b64url(Buffer.from(JSON.stringify(header)));
  const payloadB64 = b64url(Buffer.from(JSON.stringify(payload)));
  const signingInput = `${headerB64}.${payloadB64}`;

  const signer = crypto.createSign('RSA-SHA256');
  signer.update(signingInput);
  signer.end();
  const signature = b64url(signer.sign(privateKeyPem));

  bru.setVar('client_assertion', `${signingInput}.${signature}`);
}

script:post-response {
  bru.setVar('access_token', res.body.access_token);
}

docs {
  Prérequis : l'application Bruno desktop (pas l'extension VSCode, pas
  le CLI) — le pre-request script utilise le module Node natif `crypto`
  pour signer un JWT RS256, disponible uniquement dans le moteur de
  script de l'appli desktop.

  Flow client_credentials fonctionnel sur Okta free tier : Org
  Authorization Server (/oauth2/v1/token) + authentification
  private_key_jwt, contrairement à client-credentials-token.bru
  (Custom Authorization Server, bloqué par le SKU "NHI Authentication
  Tokens").

  Prérequis dans l'environnement :
  - client_id : celui de l'app API Services
  - oidc_kid : l'identifiant (kid) de la clé publique enregistrée sur
    l'app Okta (section Public Keys)
  - oidc_private_key_pem (Secret) : la clé privée correspondante, au
    format PEM, jamais committée

  Prérequis côté app Okta :
  - Client authentication : Public key / Private key
  - Scope okta.users.read accordé (onglet Okta API Scopes)
}
